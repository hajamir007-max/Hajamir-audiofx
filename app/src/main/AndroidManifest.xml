<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="Hajamir Audio FX"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play">

        <!--
          A real launcher Activity is required, not optional: Android 12+
          blocks a foreground service from starting when the only trigger is
          a background broadcast (like the root shell's `am broadcast`),
          with no exemption. Opening this Activity once is what gives the
          app a legitimate "user-initiated" foreground start; after that the
          already-running service can be reconfigured via broadcast freely.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Hajamir Audio FX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          MainService keeps the AudioEffect instances alive (session 0 = global
          output mix). Global effects are released when their owning process
          dies, so this MUST stay resident as a foreground service or the
          equalizer/bassboost/etc. silently detach.
        -->
        <service
            android:name=".MainService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          exported=true with no permission: this is a personal-use tool
          controlled only by the root shell running inside the Magisk/KernelSU
          module (see webroot/apply.sh). It is NOT safe as shipped for a
          general-audience app on the Play Store — any app on the device could
          in principle send this broadcast and change your audio effects.
          If you care about that, add a signature-level custom permission.
        -->
        <receiver
            android:name=".ApplyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hajamir.audiofx.ACTION_APPLY" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
